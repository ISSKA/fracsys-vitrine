# Template for local application configuration. Copy this file to .env.local
# at the repository root and adjust it for your environment.
# Only VITE_-prefixed variables are exposed to the browser bundle by Vite.

# Mesh API used to request signed model-download URLs.
VITE_MESH_DOWNLOAD_API_ENDPOINT=https://xhx5lqfvq1.execute-api.eu-central-1.amazonaws.com/prod/download-url

# Grid CSV loaded from public/data/.
VITE_DEFAULT_GRID_FILENAME=flow_network_voxels.csv
