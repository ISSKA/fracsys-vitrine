# Template for local env configuration. Copy this file to .env and edit it there:
#   cp .env.example .env
# .env and .env.local are git-ignored; .env.local takes precedence over .env.
# Only VITE_-prefixed variables are exposed to the browser bundle by Vite.

# Grid CSV to load on startup, resolved relative to public/data/.
# Note: public/data/*.csv is git-ignored, so a fresh clone has no grid file and
# will fall back to the generated sample grid until you add one.
VITE_DEFAULT_GRID_FILENAME=flow_network_voxels.csv
