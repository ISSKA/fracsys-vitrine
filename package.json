{
  "name": "fracsys-vitrine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "vitrine-meshviewer/webapp/html",
    "vitrine-flowviewer"
  ],
  "scripts": {
    "dev": "vite",
    "dev:mesh": "vite --open /",
    "dev:flow": "vite --open /flow/",
    "build": "npm run type-check && vite build",
    "build:preview": "npm run type-check && vite build --base=/preview/",
    "preview": "vite preview",
    "type-check": "npm run type-check:mesh && npm run type-check:flow",
    "type-check:mesh": "tsc --noEmit --project vitrine-meshviewer/webapp/html/tsconfig.json",
    "type-check:flow": "tsc --noEmit --project vitrine-flowviewer/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
