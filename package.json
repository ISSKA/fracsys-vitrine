{
  "name": "fracsys-vitrine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mesh": "vite --open /",
    "dev:flow": "vite --open /flow/",
    "build": "npm run type-check && vite build",
    "build:preview": "npm run type-check && vite build --base=/preview/",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@kitware/vtk.js": "^30.0.0",
    "papaparse": "^5.5.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.184.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
